{
 "displayName": "NEARVOLT ${SERVICE} \u2014 High memory",
 "documentation": {
  "content": "Container memory > 85%. Possible leak or too-small MEMORY setting.",
  "mimeType": "text/markdown"
 },
 "combiner": "OR",
 "conditions": [
  {
   "displayName": "Memory p99 > 85%",
   "conditionThreshold": {
    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\"",
    "comparison": "COMPARISON_GT",
    "thresholdValue": 0.85,
    "duration": "300s",
    "aggregations": [
     {
      "alignmentPeriod": "60s",
      "perSeriesAligner": "ALIGN_PERCENTILE_99",
      "crossSeriesReducer": "REDUCE_MAX"
     }
    ]
   }
  }
 ],
 "severity": "ERROR",
 "notificationChannels": [
  "${CHANNEL}"
 ],
 "alertStrategy": {
  "autoClose": "1800s"
 }
}