{
 "displayName": "NEARVOLT ${SERVICE} \u2014 Google Sheets sync delayed",
 "documentation": {
  "content": "Oldest unsynced Sheets row is older than 15 minutes. Check sheet sharing, quotas, and FAULT_SHEETS (staging).",
  "mimeType": "text/markdown"
 },
 "combiner": "OR",
 "conditions": [
  {
   "displayName": "delayed sync",
   "conditionThreshold": {
    "filter": "metric.type=\"logging.googleapis.com/user/nearvolt_sheets_delayed\" AND resource.type=\"cloud_run_revision\"",
    "comparison": "COMPARISON_GT",
    "thresholdValue": 0,
    "duration": "300s",
    "aggregations": [
     {
      "alignmentPeriod": "60s",
      "perSeriesAligner": "ALIGN_RATE",
      "crossSeriesReducer": "REDUCE_SUM"
     }
    ]
   }
  }
 ],
 "severity": "WARNING",
 "notificationChannels": [
  "${CHANNEL}"
 ],
 "alertStrategy": {
  "autoClose": "1800s"
 }
}