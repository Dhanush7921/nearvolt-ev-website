{
 "displayName": "NEARVOLT ${SERVICE} \u2014 High API latency",
 "documentation": {
  "content": "p95 request latency > 1 s for 5 min (peak SLO). Normal target is < 500 ms.",
  "mimeType": "text/markdown"
 },
 "combiner": "OR",
 "conditions": [
  {
   "displayName": "p95 latency > 1000 ms",
   "conditionThreshold": {
    "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"${SERVICE}\"",
    "comparison": "COMPARISON_GT",
    "thresholdValue": 1000,
    "duration": "300s",
    "aggregations": [
     {
      "alignmentPeriod": "60s",
      "perSeriesAligner": "ALIGN_PERCENTILE_95",
      "crossSeriesReducer": "REDUCE_MAX"
     }
    ]
   }
  }
 ],
 "severity": "ERROR",
 "notificationChannels": [
  "${CHANNEL}"
 ],
 "alertStrategy": {
  "autoClose": "1800s"
 }
}