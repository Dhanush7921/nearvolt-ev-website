{
 "displayName": "NEARVOLT ${SERVICE} \u2014 Load shedding active",
 "documentation": {
  "content": "Instances are shedding low-priority requests. Raise MAX_INSTANCES or investigate a slow dependency.",
  "mimeType": "text/markdown"
 },
 "combiner": "OR",
 "conditions": [
  {
   "displayName": "load_shed events",
   "conditionThreshold": {
    "filter": "metric.type=\"logging.googleapis.com/user/nearvolt_load_shed\" AND resource.type=\"cloud_run_revision\"",
    "comparison": "COMPARISON_GT",
    "thresholdValue": 0.1,
    "duration": "300s",
    "aggregations": [
     {
      "alignmentPeriod": "60s",
      "perSeriesAligner": "ALIGN_RATE",
      "crossSeriesReducer": "REDUCE_SUM"
     }
    ]
   }
  }
 ],
 "severity": "WARNING",
 "notificationChannels": [
  "${CHANNEL}"
 ],
 "alertStrategy": {
  "autoClose": "1800s"
 }
}