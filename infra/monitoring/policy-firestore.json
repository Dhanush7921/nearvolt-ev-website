{
 "displayName": "NEARVOLT ${SERVICE} \u2014 Firestore contention/quota errors",
 "documentation": {
  "content": "ABORTED / RESOURCE_EXHAUSTED / DEADLINE_EXCEEDED from Firestore. Look for hot documents and ramp-up limits.",
  "mimeType": "text/markdown"
 },
 "combiner": "OR",
 "conditions": [
  {
   "displayName": "firestore errors",
   "conditionThreshold": {
    "filter": "metric.type=\"logging.googleapis.com/user/nearvolt_firestore_errors\" AND resource.type=\"cloud_run_revision\"",
    "comparison": "COMPARISON_GT",
    "thresholdValue": 0.05,
    "duration": "300s",
    "aggregations": [
     {
      "alignmentPeriod": "60s",
      "perSeriesAligner": "ALIGN_RATE",
      "crossSeriesReducer": "REDUCE_SUM"
     }
    ]
   }
  }
 ],
 "severity": "ERROR",
 "notificationChannels": [
  "${CHANNEL}"
 ],
 "alertStrategy": {
  "autoClose": "1800s"
 }
}