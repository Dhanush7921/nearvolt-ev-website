{
  "name": "nearvolt-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "NEARVOLT EV shared API (Cloud Run) — /api/v1",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "firebase emulators:exec --project demo-nearvolt --only firestore,auth --config ../firebase/firebase.json \"node --test --test-concurrency=1 test/*.test.js\"",
    "test:unit": "node --test test/unit.*.test.js",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@googleapis/sheets": "^18.1.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.1",
    "geofire-common": "^6.0.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.37.0",
    "supertest": "^7.3.2"
  }
}
