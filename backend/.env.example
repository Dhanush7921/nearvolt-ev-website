# Backend configuration. In Cloud Run these come from the deploy workflow; secrets come from Secret Manager.
NODE_ENV=development
APP_ENV=dev
PORT=8080
CORS_ORIGINS=http://localhost:5173
STORAGE_BUCKET=
REQUIRE_APP_CHECK=false
REQUIRE_ADMIN_MFA=true
REQUEST_TTL_SECONDS=300
MAX_SEARCH_RADIUS_KM=15
# Secrets (Secret Manager in production; leave empty locally to keep phone login disabled)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_HASH_SALT=
SHEETS_SPREADSHEET_ID=
INTERNAL_OIDC_AUDIENCE=
INTERNAL_OIDC_SA_EMAIL=
# Scalability (tune from load tests)
TASKS_QUEUE=
PUBLIC_URL=
MAX_INFLIGHT=60
MAX_LAG_MS=250
REQUEST_DEADLINE_MS=15000
WRITE_DEADLINE_MS=28000
NEARBY_CACHE_MS=5000
IP_LIMIT_PER_15MIN=600
OTP_IP_LIMIT_PER_HOUR=60
# Staging/test only — the server refuses to start with these in APP_ENV=prod
OTP_PROVIDER=msg91
FAULT_SHEETS=false
FAULT_FCM=false
