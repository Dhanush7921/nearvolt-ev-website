rules_version = '2';
// NEARVOLT EV: clients never read or write Firestore directly.
// All access goes through the authenticated /api/v1 backend (Admin SDK), which enforces roles,
// ownership, state transitions and privacy (e.g. exact host locations). Deny everything here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
